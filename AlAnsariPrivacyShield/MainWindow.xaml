<Window x:Class="AlAnsariPrivacyShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlAnsariPrivacyShield.ViewModels"
        Title="Al-Ansari Privacy Shield v1.0.0 - Windows Privacy Hardening"
        Width="1180" Height="820"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{x:Static SystemColors.ControlBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Privacy">
                <MenuItem Header="_Apply changes" Command="{Binding ApplyCommand}" />
                <MenuItem Header="_Load selected profile" Command="{Binding ApplyProfileCommand}" />
                <Separator />
                <MenuItem Header="Select _all protections" Command="{Binding ProtectAllCommand}" />
                <MenuItem Header="_Clear selection" Command="{Binding ClearSelectionCommand}" />
                <Separator />
                <MenuItem Header="_Restore everything" Command="{Binding RestoreAllCommand}" />
            </MenuItem>
            <MenuItem Header="_Backup">
                <MenuItem Header="_Open backup folder" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="_Export report" Command="{Binding ExportReportCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PendingText}" />
                    <TextBlock Text="   Score: " />
                    <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">

            <!-- ================= DASHBOARD ================= -->
            <TabItem Header="Dashboard">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Privacy score" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{Binding ScoreText}" FontSize="46" FontWeight="Bold" />
                                <TextBlock Text="protected" FontSize="11"
                                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding Score, Mode=OneWay}" />
                                <TextBlock Text="{Binding ScoreDetail}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding PendingText}" FontSize="11"
                                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="Apply changes" Padding="14,5" Margin="0,0,0,6"
                                        Command="{Binding ApplyCommand}" />
                                <Button Content="Restore everything" Padding="14,5"
                                        Command="{Binding RestoreAllCommand}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Profiles" Padding="10" Margin="0,0,4,0">
                            <StackPanel>
                                <ComboBox Height="24"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                                <TextBlock Text="{Binding ProfileDescription}" TextWrapping="Wrap"
                                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                                           FontSize="11" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Load profile" Padding="14,4"
                                            Command="{Binding ApplyProfileCommand}" />
                                    <Button Content="Protect all" Padding="14,4" Margin="6,0,0,0"
                                            Command="{Binding ProtectAllCommand}" />
                                    <Button Content="Clear selection" Padding="14,4" Margin="6,0,0,0"
                                            Command="{Binding ClearSelectionCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Categories" Padding="10" Margin="4,0,0,0">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         VerticalAlignment="Center" Margin="6,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="Notes" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Text="Privacy Shield changes documented Windows settings only: registry policies, service start types and user preferences. No driver, no kernel component and no background service are installed." />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Profiles only select the protections — nothing is written until you click Apply changes. Some changes take effect after a sign-out or a restart." />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       Text="Every original value is saved before being modified. Restore everything puts Windows back exactly as it was." />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= PROTECTIONS ================= -->
            <TabItem Header="Protections">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply changes" Padding="14,4" Command="{Binding ApplyCommand}" />
                            <Button Content="Select all" Padding="14,4" Margin="6,0,0,0"
                                    Command="{Binding ProtectAllCommand}" />
                            <Button Content="Clear selection" Padding="14,4" Margin="6,0,0,0"
                                    Command="{Binding ClearSelectionCommand}" />
                            <Button Content="Refresh" Padding="14,4" Margin="6,0,0,0"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{x:Static SystemColors.GrayTextBrush}"
                                   Text="Changes are written only when you click Apply changes." />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SettingsView}" Margin="0,0,8,0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <GroupBox Header="{Binding Name}" Margin="0,0,0,8" Padding="8">
                                                            <ItemsPresenter />
                                                        </GroupBox>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsProtected, Mode=TwoWay}"
                                                  VerticalAlignment="Top">
                                            <StackPanel Margin="2,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Hint}" FontSize="11" FontStyle="Italic"
                                                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>

                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   FontSize="11" Margin="0,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= BACKUP ================= -->
            <TabItem Header="Backup &amp; Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Backup and restore" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding BackupSummary}" FontWeight="Bold" />
                            <TextBlock Text="{Binding BackupFolder}"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Restore everything" Padding="14,4" Margin="0,0,6,0"
                                        Command="{Binding RestoreAllCommand}" />
                                <Button Content="Export report" Padding="14,4" Margin="0,0,6,0"
                                        Command="{Binding ExportReportCommand}" />
                                <Button Content="Open folder" Padding="14,4" Margin="0,0,6,0"
                                        Command="{Binding OpenFolderCommand}" />
                                <Button Content="Refresh" Padding="14,4"
                                        Command="{Binding RefreshCommand}" />
                            </WrapPanel>

                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       Text="Backups contain the original registry values and service start types for everything Privacy Shield has changed. They stay on this computer." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Change log" Padding="8" Margin="0,8,0,0">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
