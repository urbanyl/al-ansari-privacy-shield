<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AlAnsariPrivacyShield</AssemblyName>
    <RootNamespace>AlAnsariPrivacyShield</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Al-Ansari Privacy Shield</Product>
    <Company>Al-Ansari</Company>
    <Description>Reversible Windows privacy hardening tool</Description>
    <Version>1.0.0</Version>
    <AssemblyTitle>Al-Ansari Privacy Shield</AssemblyTitle>
    <Platforms>AnyCPU;x64</Platforms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
